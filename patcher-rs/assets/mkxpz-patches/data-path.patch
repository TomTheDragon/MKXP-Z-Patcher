+/* With a data folder of its own (dataPath): settings and key bindings saved
+ * in the per-user folder before (SDL_GetPrefPath: ~/.local/share/<title>,
+ * %APPDATA%\<title>) are copied over once, when there are none yet. That
+ * folder is found without SDL_GetPrefPath, which would create it. */
+/* Older engines saved frame interpolation as on/off; an old "on" taken over
+ * into a new data folder would switch it on in every newly patched game, so
+ * the copy starts with it off. */
+static void resetLegacyInterpolation(const std::string &path) {
+    json::value conf = readConfFile(path.c_str());
+    if (!conf.is_object())
+        return;
+    auto &obj = conf.as_object();
+    auto it = obj.find("frameInterpolation");
+    if (it == obj.end() || !it->second.is_boolean())
+        return;
+    it->second = json::value((int) 0);
+    std::string text = conf.stringify(json::rule::space_indent<4>()) + "\n";
+    FILE *f = fopen(path.c_str(), "wb");
+    if (!f)
+        return;
+    fwrite(text.data(), 1, text.size(), f);
+    fclose(f);
+}
+
+void Config::migrateUserFiles(const std::string &app) {
+    std::string base;
+#ifdef _WIN32
+    const char *appdata = SDL_getenv("APPDATA");
+    if (appdata)
+        base = appdata;
+#elif !defined(__APPLE__)
+    const char *xdg = SDL_getenv("XDG_DATA_HOME");
+    const char *home = SDL_getenv("HOME");
+    if (xdg && *xdg)
+        base = xdg;
+    else if (home)
+        base = std::string(home) + "/.local/share";
+#endif
+    if (base.empty() || app.empty())
+        return;
+    try {
+        const cfs::path from = cfs::u8path(base) / cfs::u8path(app);
+        const cfs::path to = cfs::u8path(customDataPath);
+        if (!cfs::is_directory(from) || cfs::equivalent(from, to))
+            return;
+        for (const char *name : { CONF_FILE, "keybindings.mkxp1", "keybindings.mkxp2", "keybindings.mkxp3" }) {
+            if (cfs::exists(from / name) && !cfs::exists(to / name)) {
+                cfs::copy_file(from / name, to / name);
+                Debug() << "Took over" << (from / name).u8string() << "into" << to.u8string();
+                if (std::string(name) == CONF_FILE)
+                    resetLegacyInterpolation((to / name).u8string());
+            }
+        }
+    } catch (...) {
+    }
+}
