 #include <cmath>
 #include <assert.h>
 
+#ifdef __ANDROID__
+/* MKXP-Z Patcher: Android has only the game's window, so the menu draws into
+ * a surface that the app shows over the game (GameActivity); the app sends
+ * touches back as mouse events for androidMenuID, and keys go to the menu
+ * while it is open */
+#include <jni.h>
+#include <SDL_system.h>
+#include <SDL_events.h>
+#include <vector>
+
+static const uint32_t androidMenuID = 0x6d6b7870;
+
+/* GameActivity.<method>(width, height, RGBA pixels), or <method>() without a
+ * surface */
+static void androidCallActivity(const char *method, SDL_Surface *surf)
+{
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jobject act = env ? (jobject) SDL_AndroidGetActivity() : 0;
+	if (!act)
+		return;
+	jclass cls = env->GetObjectClass(act);
+	jmethodID m = env->GetMethodID(cls, method, surf ? "(II[B)V" : "()V");
+	if (m && surf)
+	{
+		const int row = surf->w * 4;
+		std::vector<uint8_t> px((size_t) row * surf->h);
+		for (int y = 0; y < surf->h; ++y)
+			memcpy(&px[(size_t) y * row], (const uint8_t*) surf->pixels + y * surf->pitch, row);
+		for (size_t i = 3; i < px.size(); i += 4)
+			px[i] = 255;
+		jbyteArray arr = env->NewByteArray((jsize) px.size());
+		if (arr)
+		{
+			env->SetByteArrayRegion(arr, 0, (jsize) px.size(), (const jbyte*) px.data());
+			env->CallVoidMethod(act, m, surf->w, surf->h, arr);
+			env->DeleteLocalRef(arr);
+		}
+	}
+	else if (m)
+	{
+		env->CallVoidMethod(act, m);
+	}
+	if (env->ExceptionCheck())
+		env->ExceptionClear();
+	env->DeleteLocalRef(cls);
+	env->DeleteLocalRef(act);
+}
+
+/* from GameActivity's settings overlay: kind 0 = motion (button: held),
+ * 1 = button down, 2 = button up (button: 1 left, 3 right), 3 = the finger
+ * left, 4 = Escape (Back) */
+extern "C" JNIEXPORT void JNICALL
+Java_org_mkxpz_patcher_GameActivity_nativeSettingsInput(JNIEnv*, jclass, jint kind, jint x, jint y, jint button)
+{
+	SDL_Event e;
+	SDL_zero(e);
+	switch (kind)
+	{
+	case 0:
+		e.type = SDL_MOUSEMOTION;
+		e.motion.windowID = androidMenuID;
+		e.motion.x = x;
+		e.motion.y = y;
+		e.motion.state = button ? SDL_BUTTON_LMASK : 0;
+		break;
+	case 1:
+	case 2:
+		e.type = kind == 1 ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+		e.button.windowID = androidMenuID;
+		e.button.button = button == 3 ? SDL_BUTTON_RIGHT : SDL_BUTTON_LEFT;
+		e.button.state = kind == 1 ? SDL_PRESSED : SDL_RELEASED;
+		e.button.clicks = 1;
+		e.button.x = x;
+		e.button.y = y;
+		break;
+	case 3:
+		e.type = SDL_WINDOWEVENT;
+		e.window.windowID = androidMenuID;
+		e.window.event = SDL_WINDOWEVENT_LEAVE;
+		break;
+	case 4:
+		e.type = SDL_KEYDOWN;
+		e.key.windowID = androidMenuID;
+		e.key.state = SDL_PRESSED;
+		e.key.keysym.scancode = SDL_SCANCODE_ESCAPE;
+		e.key.keysym.sym = SDLK_ESCAPE;
+		break;
+	default:
+		return;
+	}
+	SDL_PushEvent(&e);
+}
+#endif
