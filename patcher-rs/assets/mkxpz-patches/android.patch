+             ],
+             cross_configure_options: [
++                # MKXP-Z Patcher: Android's host name (x86_64-unknown-android)
++                # matches none of the Linux patterns, and the fallback
++                # (pthread) needs pthread_cancel, which Android lacks
++                host_machine.system() == 'android' ? '--with-coroutine=' + {'x86_64': 'amd64', 'aarch64': 'arm64', 'arm': 'arm32', 'x86': 'x86'}.get(host_machine.cpu_family(), 'ucontext') : [],
