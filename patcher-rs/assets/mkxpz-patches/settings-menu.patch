+void CheckBox::drawHandler(SDL_Surface *surf)
+{
+	const int box = 16;
+	const int by = (rect.h - box) / 2;
+
+	if (hovered)
+		p->fillRect(surf, cBgDark, 0, 0, rect.w, rect.h);
+
+	p->strokeRectInner(surf, cLine, 4, by, box, box, 2);
+	if (*value)
+		p->fillRect(surf, 4 + 4, by + 4, box - 8, box - 8, 120, 200, 120);
+
+	p->drawText(surf, str, 4 + box + 8, rect.h/2, rect.w - box - 16, Left);
+}
+
+void CheckBox::motionHandler(int, int)
+{
+	if (!hovered)
+	{
+		hovered = true;
+		p->redraw();
+	}
+}
+
+void CheckBox::leaveHandler()
+{
+	if (hovered)
+	{
+		hovered = false;
+		p->redraw();
+	}
+}
+
+void CheckBox::clickHandler(int, int, uint8_t button)
+{
+	if (button != SDL_BUTTON_LEFT)
+		return;
+
+	*value = !*value;
+	p->redraw();
+}
+
+void Slider::setFromX(int x)
+{
+	int v = (int) std::lround((x - trackX()) * 100.0 / trackW());
+	v = clamp(v, 0, 100);
+
+	if (v == *value)
+		return;
+
+	*value = v;
+	p->onVolumeChanged();
+	p->redraw();
+}
+
+void Slider::dragTo(int x)
+{
+	setFromX(x - rect.x);
+}
+
+void Slider::clickHandler(int x, int, uint8_t button)
+{
+	if (button != SDL_BUTTON_LEFT)
+		return;
+
+	p->dragged = this;
+	setFromX(x);
+}
+
+void Slider::drawHandler(SDL_Surface *surf)
+{
+	const int midY = rect.h / 2;
+	const int tx = trackX();
+	const int tw = trackW();
+
+	p->drawText(surf, str, 4, midY, tx - 12, Left);
+
+	/* track, filled up to the level */
+	p->fillRect(surf, cBgDark, tx, midY - 3, tw, 6);
+	p->fillRect(surf, tx, midY - 3, tw * *value / 100, 6, 120, 200, 120);
+
+	/* handle */
+	const int hx = tx + tw * *value / 100;
+	p->fillRect(surf, 200, hx - 4, midY - 9, 8, 18);
+	p->strokeRectInner(surf, cLine, hx - 4, midY - 9, 8, 18, 1);
+
+	char buf[16];
+	snprintf(buf, sizeof(buf), "%d%%", *value);
+	p->drawText(surf, buf, tx + tw + 10, midY, 46, Left);
+}
