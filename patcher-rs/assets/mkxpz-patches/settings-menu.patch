+bool Config::storeUserSettings() const {
+    if (userConfPath.empty())
+        return false;
+    
+    /* Keep anything else the file holds */
+    json::value conf = readConfFile(userConfPath.c_str());
+    auto &obj = conf.as_object();
+    obj["vsync"] = json::value(vsync);
+    obj["fullscreen"] = json::value(fullscreen);
+    obj["frameInterpolation"] = json::value(frameInterpolation);
+    obj["musicVolume"] = json::value((int) musicVolume);
+    obj["soundVolume"] = json::value((int) soundVolume);
+    
+    std::string text = conf.stringify(json::rule::space_indent<4>()) + "\n";
+    FILE *f = fopen(userConfPath.c_str(), "wb");
+    if (!f) {
+        Debug() << "Couldn't save settings to" << userConfPath;
+        return false;
+    }
+    bool ok = fwrite(text.data(), 1, text.size(), f) == text.size();
+    ok = (fclose(f) == 0) && ok;
+    if (!ok)
+        Debug() << "Couldn't save settings to" << userConfPath;
+    return ok;
+}
