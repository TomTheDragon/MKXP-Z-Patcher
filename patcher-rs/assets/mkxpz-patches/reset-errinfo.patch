+            if (!NIL_P(resetExc))
+                rb_set_errinfo(resetExc);
+            
             VALUE script = rb_ary_entry(scriptArray, i);
             VALUE scriptDecoded = rb_ary_entry(script, 3);
             VALUE string =
@@ -1099,14 +1112,20 @@
             int state;
             
             evalString(string, fname, &state);
+            lastState = state;
             if (state)
                 break;
         }
         
+        /* the scripts ended without an error: the game is over */
+        if (!lastState)
+            break;
+        
         VALUE exc = rb_gv_get("$!");
         if (rb_obj_class(exc) != getRbData()->exc[Reset])
             break;
         
+        resetExc = exc;
         if (processReset(false))
             break;
     }
