--- a/binding/binding-mri.cpp
+++ b/binding/binding-mri.cpp
@@ -1048,11 +1048,24 @@
     if (exc != Qnil)
         return;
     
+    /* Set while the scripts run again after a reset (see below) */
+    VALUE resetExc = Qnil;
+    
     while (true) {
+        int lastState = 0;
+        
         for (long i = 0; i < scriptCount; ++i) {
             if (shState->rtData().rqTerm)
                 break;
             
+            /* As in RGSS, scripts that run again after a reset see the
+             * reset exception in $! / $@: games guard their aliases with
