+	 * shader passes into the window's default framebuffer, in the
+	 * rectangle `dst` (GL window coordinates). */
+	void render(const TEXFBO &source, const Vec2i &inputSize, const IntRect &dst, const Vec2i &winSize);
+
+	/* Set when the driver failed to draw a freshly loaded shader (which
+	 * is then off); returns it once */
+	std::string takeError();
+}
+
+#endif // RETROSHADER_H
