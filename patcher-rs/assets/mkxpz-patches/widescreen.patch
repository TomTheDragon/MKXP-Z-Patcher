+/* Widescreen mode (added by the MKXP-Z Patcher): change the game's screen
+ * size without the window following it, e.g. between a 16:9 map and the
+ * game's own 4:3 menus. The screen shows letterboxed in the window, which
+ * only takes the aspect ratio of frameWidth x height: its height (and so
+ * its scale) stays, and fullscreen or maximized windows aren't touched.
+ * The picture frozen for the next transition is kept, centered, so scene
+ * changes still fade from the old scene. */
+void Graphics::widescreenResize(int width, int height, int frameWidth) {
+    width = clamp(width, 16, 8192);
+    height = clamp(height, 16, 8192);
+    
+    if (p->scResLores != Vec2i(width, height)) {
+        const int oldW = p->frozenScene.width, oldH = p->frozenScene.height;
+        const bool keep = oldW > 0 && oldH > 0;
+        TEXFBO saved;
+        
+        if (keep) {
+            TEXFBO::init(saved);
+            TEXFBO::allocEmpty(saved, oldW, oldH);
+            TEXFBO::linkFBO(saved);
+            GLMeta::blitBegin(saved);
+            GLMeta::blitSource(p->frozenScene);
+            GLMeta::blitRectangle(IntRect(0, 0, oldW, oldH), Vec2i(0, 0));
+            GLMeta::blitEnd();
+        }
+        
+        resizeScreen(width, height, false);
+        p->screenSizeChanged();
+        
+        if (keep) {
+            const int newW = p->frozenScene.width, newH = p->frozenScene.height;
+            const int w = std::min(oldW, newW), h = std::min(oldH, newH);
+            
+            glState.clearColor.pushSet(Vec4(0, 0, 0, 1));
+            FBO::bind(p->frozenScene.fbo);
+            FBO::clear();
+            glState.clearColor.pop();
+            
+            GLMeta::blitBegin(p->frozenScene);
+            GLMeta::blitSource(saved);
+            GLMeta::blitRectangle(IntRect((oldW - w) / 2, (oldH - h) / 2, w, h),
+                                  Vec2i((newW - w) / 2, (newH - h) / 2));
+            GLMeta::blitEnd();
+            TEXFBO::fini(saved);
+        }
+    }
+    
+    /* the window: the frame's aspect ratio at its current height */
+    if (frameWidth <= 0 || getFullscreen())
+        return;
+    SDL_Window *win = shState->sdlWindow();
+    if (SDL_GetWindowFlags(win) & SDL_WINDOW_MAXIMIZED)
+        return;
+    
+    p->threadData->rqWindowAdjust.wait();
+    p->checkResize();
+    const int winW = (int) (p->winSize.x / p->backingScaleFactor);
+    const int winH = (int) (p->winSize.y / p->backingScaleFactor);
+    const int want = (int) lround((double) winH * frameWidth / height);
+    if (winH <= 0 || std::abs(want - winW) <= 2)
+        return;
+    
+    /* grow or shrink around the window's middle */
+    int x = 0, y = 0;
+    SDL_GetWindowPosition(win, &x, &y);
+    shState->eThread().requestWindowResize(want, winH);
+    p->threadData->rqWindowAdjust.wait();
+    shState->eThread().requestWindowReposition(x - (want - winW) / 2, y);
 }
 
