+void Choice::drawHandler(SDL_Surface *surf)
+{
+	const int labelW = 96;
+	p->drawText(surf, str, 4, rect.h/2, labelW - 8, Left);
+
+	const int bx = labelW, bw = rect.w - labelW - 4;
+	if (hovered)
+		p->fillRect(surf, cBgDark, bx, 1, bw, rect.h - 2);
+	p->strokeRectInner(surf, cLine, bx, 1, bw, rect.h - 2, 2);
+	const int v = clamp(*value, 0, count - 1);
+	p->drawText(surf, names[v], bx + 8, rect.h/2, bw - 40, Left);
+	p->drawText(surf, "<>", bx + bw - 26, rect.h/2, 22, Left);
+}
+
+void Choice::motionHandler(int, int)
+{
+	if (!hovered)
+	{
+		hovered = true;
+		p->redraw();
+	}
+}
+
+void Choice::leaveHandler()
+{
+	if (hovered)
+	{
+		hovered = false;
+		p->redraw();
+	}
+}
+
+void Choice::clickHandler(int, int, uint8_t button)
+{
+	if (button == SDL_BUTTON_LEFT)
+		*value = (clamp(*value, 0, count - 1) + 1) % count;
+	else if (button == SDL_BUTTON_RIGHT)
+		*value = (clamp(*value, 0, count - 1) + count - 1) % count;
+	else
+		return;
+	p->redraw();
+}
