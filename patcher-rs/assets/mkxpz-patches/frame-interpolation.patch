+/*
+** frameinterp.cpp
+**
+** Frame interpolation (added by the rpgm-patcher), see frameinterp.h.
+**
+** At each logic frame, every tracked object's position values are recorded
+** as a key frame. In-between frames set values blended between the previous
+** and the current key frame, render, and put the real values back before the
+** game's scripts run again, so scripts never see blended values.
+**
+** Values that jump (teleports, scene changes, looping planes or maps), sprites
+** that changed their bitmap or just became visible, and new objects are shown
+** as they are instead of being blended.
+**
+** This file is part of mkxp-z and is licensed under the GPL v2 or later.
+*/
+
+#include "frameinterp.h"
+
+#include "sprite.h"
+#include "plane.h"
+#include "viewport.h"
+#include "tilemap.h"
+#include "tilemapvx.h"
+#include "etc.h"
+
+#include <cmath>
+#include <unordered_map>
+
+namespace
+{
+
+enum Kind { KSprite, KPlane, KViewport, KTilemap, KTilemapVX };
+
+/* Most values per object: sprite x, y, ox, oy, zoom_x, zoom_y */
+const int MAX_VALUES = 6;
+
+/* Bigger changes within one logic frame are jumps, not movement
+ * (fast movement in RPG Maker is about 8-16 pixels per frame). */
+const double JUMP_PIXELS = 48.0;
+const double JUMP_ZOOM = 0.5;
+
+struct Entry
+{
+	Kind kind;
+	bool haveKey;      /* cur holds a key frame */
+	bool moving;       /* prev != cur and blending allowed */
+	bool applied;      /* blended values are set right now */
+	const void *tag;   /* sprite/plane bitmap, to notice reuse */
+	bool visible;
+	double prev[MAX_VALUES];
+	double cur[MAX_VALUES];
+};
+
+std::unordered_map<const void*, Entry> entries;
+
+int valueCount(Kind k)
+{
+	switch (k)
+	{
+	case KSprite:   return 6;
+	case KViewport: return 4;
+	default:        return 2;
+	}
+}
+
+bool isZoom(Kind k, int i)
+{
+	return k == KSprite && i >= 4;
+}
+
+Disposable *disposable(const void *obj, Kind k)
+{
+	void *o = const_cast<void*>(obj);
+	switch (k)
+	{
+	case KSprite:    return static_cast<Sprite*>(o);
+	case KPlane:     return static_cast<Plane*>(o);
+	case KViewport:  return static_cast<Viewport*>(o);
+	case KTilemap:   return static_cast<Tilemap*>(o);
+	case KTilemapVX: return static_cast<TilemapVX*>(o);
+	}
+	return 0;
+}
+
+/* Read the current values; returns false if the object can't be used. */
+bool read(const void *obj, Kind k, double *v, const void *&tag, bool &visible)
+{
+	tag = 0;
+	switch (k)
+	{
+	case KSprite: {
+		const Sprite *s = static_cast<const Sprite*>(obj);
+		v[0] = s->getX();
+		v[1] = s->getY();
+		v[2] = s->getOX();
+		v[3] = s->getOY();
+		v[4] = s->getZoomX();
+		v[5] = s->getZoomY();
+		tag = s->getBitmap();
+		visible = s->getVisible();
+		return true;
+	}
+	case KPlane: {
+		const Plane *p = static_cast<const Plane*>(obj);
+		v[0] = p->getOX();
+		v[1] = p->getOY();
+		tag = p->getBitmap();
+		visible = p->getVisible();
+		return true;
+	}
+	case KViewport: {
+		Viewport *vp = static_cast<Viewport*>(const_cast<void*>(obj));
+		const Rect &r = vp->getRect();
+		v[0] = r.x;
+		v[1] = r.y;
+		v[2] = vp->getOX();
+		v[3] = vp->getOY();
+		visible = vp->getVisible();
+		return true;
+	}
+	case KTilemap: {
+		const Tilemap *t = static_cast<const Tilemap*>(obj);
+		v[0] = t->getOX();
+		v[1] = t->getOY();
+		visible = t->getVisible();
+		return true;
+	}
+	case KTilemapVX: {
+		const TilemapVX *t = static_cast<const TilemapVX*>(obj);
+		v[0] = t->getOX();
+		v[1] = t->getOY();
+		visible = t->getVisible();
+		return true;
+	}
+	}
+	return false;
+}
+
+int px(double v)
+{
+	return (int) std::lround(v);
+}
+
+/* Set values; `old` holds what is set now, so unchanged ones are skipped. */
+void write(const void *obj, Kind k, const double *v, const double *old)
+{
+	void *o = const_cast<void*>(obj);
+	switch (k)
+	{
+	case KSprite: {
+		Sprite *s = static_cast<Sprite*>(o);
+		if (px(v[0]) != px(old[0]) || px(v[1]) != px(old[1]))
+			s->setInterpPosition(px(v[0]), px(v[1]));
+		if (px(v[2]) != px(old[2]))
+			s->setOX(px(v[2]));
+		if (px(v[3]) != px(old[3]))
+			s->setOY(px(v[3]));
+		if (v[4] != old[4])
+			s->setZoomX((float) v[4]);
+		if (v[5] != old[5])
+			s->setZoomY((float) v[5]);
+		break;
+	}
+	case KPlane: {
+		Plane *p = static_cast<Plane*>(o);
+		if (px(v[0]) != px(old[0]))
+			p->setOX(px(v[0]));
+		if (px(v[1]) != px(old[1]))
+			p->setOY(px(v[1]));
+		break;
+	}
+	case KViewport: {
+		Viewport *vp = static_cast<Viewport*>(o);
+		Rect &r = vp->getRect();
+		if (px(v[0]) != px(old[0]))
+			r.setX(px(v[0]));
+		if (px(v[1]) != px(old[1]))
+			r.setY(px(v[1]));
+		if (px(v[2]) != px(old[2]))
+			vp->setOX(px(v[2]));
+		if (px(v[3]) != px(old[3]))
+			vp->setOY(px(v[3]));
+		break;
+	}
+	case KTilemap: {
+		Tilemap *t = static_cast<Tilemap*>(o);
+		if (px(v[0]) != px(old[0]))
+			t->setOX(px(v[0]));
+		if (px(v[1]) != px(old[1]))
+			t->setOY(px(v[1]));
+		break;
+	}
+	case KTilemapVX: {
+		TilemapVX *t = static_cast<TilemapVX*>(o);
+		if (px(v[0]) != px(old[0]))
+			t->setOX(px(v[0]));
+		if (px(v[1]) != px(old[1]))
+			t->setOY(px(v[1]));
+		break;
+	}
+	}
+}
+
+void add(const void *obj, Kind k)
+{
+	Entry e = Entry();
+	e.kind = k;
+	entries[obj] = e;
+}
+
+/* The values blended for `alpha` */
+void blend(const Entry &e, double alpha, double *out)
+{
+	for (int i = 0; i < valueCount(e.kind); ++i)
+		out[i] = e.prev[i] + (e.cur[i] - e.prev[i]) * alpha;
+}
+
+double lastAlpha = 1.0;
+
+} // namespace
+
+namespace FrameInterp
+{
+
+void track(Sprite *s)    { add(s, KSprite); }
+void track(Plane *p)     { add(p, KPlane); }
+void track(Viewport *v)  { add(v, KViewport); }
+void track(Tilemap *t)   { add(t, KTilemap); }
+void track(TilemapVX *t) { add(t, KTilemapVX); }
+
+void untrack(const void *obj)
+{
+	entries.erase(obj);
+}
+
+void capture()
+{
+	for (auto &it : entries)
+	{
+		Entry &e = it.second;
+		e.moving = false;
+		e.applied = false;
+
+		Disposable *d = disposable(it.first, e.kind);
+		if (!d || d->isDisposed())
+		{
+			e.haveKey = false;
+			continue;
+		}
+
+		double v[MAX_VALUES];
+		const void *tag;
+		bool visible = false;
+		if (!read(it.first, e.kind, v, tag, visible))
+		{
+			e.haveKey = false;
+			continue;
+		}
+
+		const int n = valueCount(e.kind);
+		bool blendable = e.haveKey && visible && e.visible && tag == e.tag;
+		bool changed = false;
+		for (int i = 0; i < n && blendable; ++i)
+		{
+			double delta = std::fabs(v[i] - e.cur[i]);
+			if (delta > (isZoom(e.kind, i) ? JUMP_ZOOM : JUMP_PIXELS))
+				blendable = false;
+			else if (delta != 0)
+				changed = true;
+		}
+
+		for (int i = 0; i < n; ++i)
+		{
+			e.prev[i] = blendable ? e.cur[i] : v[i];
+			e.cur[i] = v[i];
+		}
+		e.moving = blendable && changed;
+		e.haveKey = true;
+		e.tag = tag;
+		e.visible = visible;
+	}
+	lastAlpha = 1.0;
+}
+
+void reset()
+{
+	for (auto &it : entries)
+	{
+		it.second.haveKey = false;
+		it.second.moving = false;
+	}
+}
+
+void apply(double alpha)
+{
+	if (alpha < 0)
+		alpha = 0;
+	if (alpha > 1)
+		alpha = 1;
+
+	for (auto &it : entries)
+	{
+		Entry &e = it.second;
+		if (!e.moving)
+			continue;
+		Disposable *d = disposable(it.first, e.kind);
+		if (!d || d->isDisposed())
+		{
+			e.moving = false;
+			continue;
+		}
+
+		double v[MAX_VALUES];
+		blend(e, alpha, v);
+		write(it.first, e.kind, v, e.cur);
+		e.applied = true;
+	}
+	lastAlpha = alpha;
+}
+
+void restore()
+{
+	for (auto &it : entries)
+	{
+		Entry &e = it.second;
+		if (!e.applied)
+			continue;
+		e.applied = false;
+		Disposable *d = disposable(it.first, e.kind);
+		if (!d || d->isDisposed())
+			continue;
+
+		double v[MAX_VALUES];
+		blend(e, lastAlpha, v);
+		write(it.first, e.kind, e.cur, v);
+	}
+	lastAlpha = 1.0;
+}
+
+} // namespace FrameInterp
