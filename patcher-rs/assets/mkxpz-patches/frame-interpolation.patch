+    /* Frame interpolation: on displays faster than the game's frame rate,
+     * fill the time until the next logic frame is due with frames whose
+     * positions are blended between the last two logic frames. */
+    bool interpFrame = false;
+    bool interpWasActive = false;
+
+    /* Frames sent to the display (logic and in-between frames), for the
+     * second FPS counter shown while frame interpolation is enabled */
+    double presentedStart = -1;
+    int presentedCount = 0;
+    double presentedRate = 0;
+
+    void countPresentedFrame() {
+        const double now = shState->runTime();
+        if (presentedStart < 0) {
+            presentedStart = now;
+            presentedCount = 0;
+            return;
+        }
+        ++presentedCount;
+        const double elapsed = now - presentedStart;
+        if (elapsed >= 0.5) {
+            presentedRate = presentedCount / elapsed;
+            presentedStart = now;
+            presentedCount = 0;
+        }
+    }
+
+    bool interpolationActive() const {
+        return threadData->config.frameInterpolation && !fpsLimiter.disabled
+            && threadData->refreshRate > frameRate + 5;
+    }
+
+    void captureInterpolation() {
+        bool active = interpolationActive();
+        if (active)
+            FrameInterp::capture();
+        else if (interpWasActive)
+            FrameInterp::reset();
+        interpWasActive = active;
+    }
+
+    void renderInterpolatedFrames() {
+        if (!interpWasActive)
+            return;
+
+        const int64_t period = (int64_t)(fpsLimiter.tickFreq / threadData->refreshRate);
+        const int64_t tpf = fpsLimiter.tpf;
+        const uint64_t start = fpsLimiter.lastTickCount;
+
+        for (int n = 0; n < 32; ++n) {
+            const uint64_t now = SDL_GetPerformanceCounter();
+            /* when the real frame is due (see FPSLimiter::delay) */
+            const int64_t untilDue = (int64_t)(start + tpf) - fpsLimiter.adj.idealDiff - (int64_t)now;
+            if (untilDue < period)
+                break;
+
+            /* the position at about the time this frame gets shown */
+            double alpha = (double)((int64_t)(now - start) + period) / (double)tpf;
+
+            FrameInterp::apply(alpha);
+            interpFrame = true;
+            try {
+                redrawScreen();
+            } catch (...) {
+                interpFrame = false;
+                FrameInterp::restore();
+                throw;
+            }
+            interpFrame = false;
+            FrameInterp::restore();
+
+            /* vsync paces the frames; without it, sleep for one refresh */
+            if (!threadData->config.vsync) {
+                const int64_t used = (int64_t)(SDL_GetPerformanceCounter() - now);
+                if (used < period)
+                    fpsLimiter.sleepTicks((uint64_t)(period - used));
+            }
+        }
     }
     
