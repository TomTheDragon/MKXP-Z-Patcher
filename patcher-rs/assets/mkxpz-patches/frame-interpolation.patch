+/*
+** frameinterp.h
+**
+** Frame interpolation (added by the rpgm-patcher): the game logic keeps
+** running at its frame rate (usually 60 Hz); on faster displays, the frames in
+** between show sprite, plane, viewport and tilemap positions blended between
+** the last two logic frames.
+**
+** This file is part of mkxp-z and is licensed under the GPL v2 or later.
+*/
+
+#ifndef FRAMEINTERP_H
+#define FRAMEINTERP_H
+
+class Sprite;
+class Plane;
+class Viewport;
+class Tilemap;
+class TilemapVX;
+
+namespace FrameInterp
+{
+	/* Objects register themselves on creation and leave on destruction */
+	void track(Sprite *s);
+	void track(Plane *p);
+	void track(Viewport *v);
+	void track(Tilemap *t);
+	void track(TilemapVX *t);
+	void untrack(const void *obj);
+
+	/* At every logic frame (Graphics.update): the state the game set up
+	 * becomes the newest key frame. */
+	void capture();
+
+	/* Forget earlier key frames (scene changes, freeze/transition, reset):
+	 * the next frames are shown as they are. */
+	void reset();
+
+	/* Set blended values for an in-between frame (0 = previous logic frame,
+	 * 1 = current), and put the real values back afterwards. Only between
+	 * capture() and the return to the game's scripts. */
+	void apply(double alpha);
+	void restore();
+}
+
+#endif // FRAMEINTERP_H
